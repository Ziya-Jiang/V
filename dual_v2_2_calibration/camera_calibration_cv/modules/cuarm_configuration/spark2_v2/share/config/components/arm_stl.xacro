<?xml version="1.0" encoding="utf-8"?>
<robot name="arm" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:macro name="arm_macro" params="base_link end_effector_link prefix meshdir">
        <xacro:property name="origin_roll_list"
            value="${'0,-1.5707963267948966,0,0,1.5707963267948966,1.5707963267948966'.split(',')}" />
        <xacro:property name="origin_pitch_list"
            value="${'0,-1.5707963267948966,0,0,-1.5707963267948966,0'.split(',')}" />
        <xacro:property name="origin_yaw_list"
            value="${'0,0,0,0,0,0'.split(',')}" />
        <xacro:property name="origin_x_list"
            value="${'0,0.096000000000000002,0.34649999999999997,0.14999999999999999,0,0'.split(',')}" />
        <xacro:property name="origin_y_list"
            value="${'0,0,0,0,-0.096000000000000002,-0.20000000000000001'.split(',')}" />
        <xacro:property name="origin_z_list"
            value="${'0.084000000000000005,0,0,0,0,0'.split(',')}" />

        <material name="silver">
            <color rgba="0.700 0.700 0.700 1.000" />
        </material>

        <link name="${prefix}_${base_link}">
            <inertial>
                <origin xyz="-2.2120147501030119e-05 3.8021109477495592e-05 0.058916921763942164" rpy="0 -0 0" />
                <mass value="0.8810661689456585" />
                <inertia ixx="0.00081700000000000002" iyy="0.00081700000000000002" izz="0.00055900000000000004" ixy="0" iyz="9.9999999999999995e-07" ixz="9.9999999999999995e-07" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 -0 0" />
                <geometry>
                    <mesh filename="${meshdir}/base_link.stl" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 -0 0" />
                <geometry>
                    <mesh filename="${meshdir}/base_link.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}_L1">
            <inertial>
                <origin xyz="0.083398040155232278 0.024092390966502224 0.0046766290966202828" rpy="0 -0 0" />
                <mass value="1.0366445476980894" />
                <inertia ixx="0.00091399999999999999" iyy="0.001539" izz="0.0017210000000000001" ixy="-0.00031700000000000001" iyz="0.000117" ixz="0.00027599999999999999" />
            </inertial>
            <visual>
                <origin xyz="0 0 -0.084000000000000005" rpy="0 -0 0" />
                <geometry>
                    <mesh filename="${meshdir}/L1.stl" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin xyz="0 0 -0.084000000000000005" rpy="0 -0 0" />
                <geometry>
                    <mesh filename="${meshdir}/L1.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}_L2">
            <inertial>
                <origin xyz="0.25925220523219406 2.754807624848199e-05 0.054429110065566479" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <mass value="1.506641024125369" />
                <inertia ixx="0.0015430000000000001" iyy="0.022436000000000001" izz="0.02206" ixy="-3.9999999999999998e-06" iyz="-9.9999999999999995e-07" ixz="0.0027920000000000002" />
            </inertial>
            <visual>
                <origin xyz="-0.084000000000000005 -0.096000000000000002 0" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L2.stl" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin xyz="-0.084000000000000005 -0.096000000000000002 0" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L2.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}_L3">
            <inertial>
                <origin xyz="0.079826476252835121 1.430320514840544e-05 -0.0039247735242233144" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <mass value="0.4975236595473459" />
                <inertia ixx="0.00031300000000000002" iyy="0.0013979999999999999" izz="0.0014519999999999999" ixy="0" iyz="0" ixz="0.000145" />
            </inertial>
            <visual>
                <origin xyz="-0.43049999999999999 -0.096000000000000002 0" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L3.stl" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin xyz="-0.43049999999999999 -0.096000000000000002 0" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L3.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}_L4">
            <inertial>
                <origin xyz="-2.0433467473601752e-08 -0.031754373052680612 0.0073571864662786805" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <mass value="0.05610708650016425" />
                <inertia ixx="4.0000000000000003e-05" iyy="1.0000000000000001e-05" izz="4.1e-05" ixy="0" iyz="-3.9999999999999998e-06" ixz="0" />
            </inertial>
            <visual>
                <origin xyz="-0.58050000000000002 -0.096000000000000002 0" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L4.stl" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin xyz="-0.58050000000000002 -0.096000000000000002 0" rpy="1.5707963267948966 -0 1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L4.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}_L5">
            <inertial>
                <origin xyz="-2.3554451646168118e-06 -0.088888790749347635 -0.00097549898463300381" rpy="1.5707963267948966 1.5707963267948966 0" />
                <mass value="0.7330014758686225" />
                <inertia ixx="0.0031970000000000002" iyy="0.000455" izz="0.0032299999999999998" ixy="-3.0000000000000001e-06" iyz="0.000126" ixz="0" />
            </inertial>
            <visual>
                <origin xyz="0 0.58050000000000002 0" rpy="1.5707963267948966 1.5707963267948966 0" />
                <geometry>
                    <mesh filename="${meshdir}/L5.stl" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin xyz="0 0.58050000000000002 0" rpy="1.5707963267948966 1.5707963267948966 0" />
                <geometry>
                    <mesh filename="${meshdir}/L5.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>

        <link name="${prefix}_L6">
            <inertial>
                <origin xyz="1.1997621315050149e-13 -9.9999999916333478e-05 -0.0060866244875072972" rpy="0 -0 -1.5707963267948966" />
                <mass value="0.049166120435743116" />
                <inertia ixx="1.4e-05" iyy="1.4e-05" izz="2.8e-05" ixy="0" iyz="0" ixz="0" />
            </inertial>  
            <visual>
                <origin xyz="0 0 -0.78049999999999997" rpy="0 -0 -1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L6.stl" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="silver" />
            </visual>
            <collision>
                <origin xyz="0 0 -0.78049999999999997" rpy="0 -0 -1.5707963267948966" />
                <geometry>
                    <mesh filename="${meshdir}/L6.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_J1" type="revolute">
            <origin xyz="${origin_x_list[0]} ${origin_y_list[0]} ${origin_z_list[0]}"
                rpy="${origin_roll_list[0]} ${origin_pitch_list[0]} ${origin_yaw_list[0]}" />
            <parent link="${prefix}_${base_link}" />
            <child link="${prefix}_L1" />
            <axis xyz="0 0 1" />
            <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100" />
        </joint>

        <joint name="${prefix}_J2" type="revolute">
            <origin xyz="${origin_x_list[1]} ${origin_y_list[1]} ${origin_z_list[1]}"
                rpy="${origin_roll_list[1]} ${origin_pitch_list[1]} ${origin_yaw_list[1]}" />
            <parent link="${prefix}_L1" />
            <child link="${prefix}_L2" />
            <axis xyz="0 0 1" />
            <limit upper="1.570796" lower="-1.570796" effort="100" velocity="100" />
        </joint>

        <joint name="${prefix}_J3" type="revolute">
            <origin xyz="${origin_x_list[2]} ${origin_y_list[2]} ${origin_z_list[2]}"
                rpy="${origin_roll_list[2]} ${origin_pitch_list[2]} ${origin_yaw_list[2]}" />
            <parent link="${prefix}_L2" />
            <child link="${prefix}_L3" />
            <axis xyz="0 0 1" />
            <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100" />
        </joint>

        <joint name="${prefix}_J4" type="revolute">
            <origin xyz="${origin_x_list[3]} ${origin_y_list[3]} ${origin_z_list[3]}"
                rpy="${origin_roll_list[3]} ${origin_pitch_list[3]} ${origin_yaw_list[3]}" />
            <parent link="${prefix}_L3" />
            <child link="${prefix}_L4" />
            <axis xyz="0 0 1" />
            <limit upper="3.141593" lower="-0.349066" effort="100" velocity="100" />
        </joint>

        <joint name="${prefix}_J5" type="revolute">
            <origin xyz="${origin_x_list[4]} ${origin_y_list[4]} ${origin_z_list[4]}"
                rpy="${origin_roll_list[4]} ${origin_pitch_list[4]} ${origin_yaw_list[4]}" />
            <parent link="${prefix}_L4" />
            <child link="${prefix}_L5" />
            <axis xyz="0 0 1" />
            <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100" />
        </joint>

        <joint name="${prefix}_J6" type="revolute">
            <origin xyz="${origin_x_list[5]} ${origin_y_list[5]} ${origin_z_list[5]}"
                rpy="${origin_roll_list[5]} ${origin_pitch_list[5]} ${origin_yaw_list[5]}" />
            <parent link="${prefix}_L5" />
            <child link="${prefix}_L6" />
            <axis xyz="0 0 1" />
            <limit upper="6.2831853" lower="-6.2831853" effort="100" velocity="100" />
        </joint>

        <link name="${prefix}_${end_effector_link}">
        </link>
        <joint name="${prefix}_J7" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${prefix}_L6" />
            <child link="${prefix}_${end_effector_link}" />
        </joint>

    </xacro:macro>
</robot>
